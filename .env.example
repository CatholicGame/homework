# Firebase web app (Project settings → General → Your apps → SDK setup and configuration)
# Mặc định dùng project "mathtieuhoc" (ghi sẵn trong src/engine/leaderboard.js); chỉ cần .env.local khi muốn trỏ sang project khác.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Đăng nhập Google có refresh token (lưu Google Drive tự động, không phải bấm lại sau 1 giờ) — dùng ở api/auth/*.
# Google Cloud Console (project mathtieuhoc) → APIs & Services → Credentials → OAuth client "Web" → Client secret.
# Production: đặt trong Vercel → Settings → Environment Variables. KHÔNG commit giá trị thật.
GOOGLE_CLIENT_SECRET=
