rules_version = '2';

// Bảng xếp hạng sao (so sánh trong cùng lớp, theo ngày/tuần/tháng/mọi lúc): ai đăng nhập cũng xem được; mỗi bé chỉ ghi được hồ sơ của mình,
// dữ liệu đúng khuôn, và tổng sao không được giảm.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admin xem được sổ đăng ký học sinh (trang #admin). Giữ khớp với ADMIN_EMAILS trong src/engine/admin.js.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['nguyencongnam506@gmail.com'];
    }

    function validStars(n) {
      return n is int && n >= 0 && n <= 20000;
    }

    // Lớp 1–5, hoặc -1 = Tiền tiểu học (0 = chưa chọn lớp). Giữ khớp với PRESCHOOL trong src/data/grades.js.
    function validGrade(g) {
      return g is int && (g == -1 || (g >= 1 && g <= 5));
    }

    // Sao theo lớp: { 'g-1'?, g1?, g2?, g3?, g4?, g5? }
    function validGradeStars(m) {
      return m is map && m.keys().hasOnly(['g-1', 'g1', 'g2', 'g3', 'g4', 'g5'])
        && (!('g-1' in m) || validStars(m['g-1']))
        && (!('g1' in m) || validStars(m.g1))
        && (!('g2' in m) || validStars(m.g2))
        && (!('g3' in m) || validStars(m.g3))
        && (!('g4' in m) || validStars(m.g4))
        && (!('g5' in m) || validStars(m.g5));
    }

    // Khoá ngày/tuần 'YYYY-MM-DD', khoá tháng 'YYYY-MM'
    function validPeriod(key, stars, len) {
      return key is string && key.size() == len && validStars(stars);
    }

    function validEntry(d) {
      return d.keys().hasOnly(['nickname', 'avatar', 'grade', 'totalStars', 'gradeStars',
                               'dayKey', 'dayStars', 'weekKey', 'weekStars', 'monthKey', 'monthStars', 'updatedAt'])
        && d.nickname is string && d.nickname.size() <= 20
        && d.avatar is string && d.avatar.size() <= 40
        && validGrade(d.grade)
        && validStars(d.totalStars)
        && validGradeStars(d.gradeStars)
        && validPeriod(d.dayKey, d.dayStars, 10)
        && validPeriod(d.weekKey, d.weekStars, 10)
        && validPeriod(d.monthKey, d.monthStars, 7)
        && d.updatedAt == request.time;
    }

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid) && validEntry(request.resource.data);
      allow update: if isOwner(uid) && validEntry(request.resource.data)
        && request.resource.data.totalStars >= resource.data.totalStars;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Ảnh chụp khởi động các bạn ảo trên bảng xếp hạng (src/engine/leaderboardCast.js), mỗi lớp một bản
    // `g{lớp}`: { start, top, updatedAt } — máy đầu tiên mở bảng của lớp ghi một lần, không ai sửa/xoá được,
    // nên sao của bạn ảo chỉ tăng và mọi máy thấy như nhau.
    match /castLaunch/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && id in ['g-1', 'g1', 'g2', 'g3', 'g4', 'g5']
        && request.resource.data.keys().hasOnly(['start', 'top', 'updatedAt'])
        && request.resource.data.start is string && request.resource.data.start.size() == 10
        && request.resource.data.top is int && request.resource.data.top >= 0 && request.resource.data.top <= 20000
        && request.resource.data.updatedAt == request.time;
    }

    // Hồ sơ riêng của bé (trai/gái, avatar, tên, lớp) để máy khác cùng tài khoản không hỏi lại.
    // Chỉ chính bé đọc/ghi được.
    function validProfile(d) {
      return d.keys().hasOnly(['gender', 'avatar', 'name', 'grade', 'updatedAt'])
        && d.gender in ['', 'boy', 'girl']
        && d.avatar is string && d.avatar.size() <= 40
        && d.name is string && d.name.size() <= 20
        && validGrade(d.grade)
        && d.updatedAt == request.time;
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
    }

    // Xác nhận của phụ huynh (Nghị định 13/2023): ghi một lần, không sửa, không xoá từ app.
    match /consents/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['text', 'at', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.at is int
        && request.resource.data.createdAt == request.time;
    }

    // Sổ đăng ký học sinh: mỗi bé tự ghi khi mở app (tối đa 1 lần/ngày) — admin đếm số bé đã đăng ký
    // và số bé đang hoạt động. createdAt ghi một lần, không đổi được; email phải đúng tài khoản đăng nhập.
    function validUser(d) {
      return d.keys().hasOnly(['email', 'name', 'grade', 'createdAt', 'lastSeenAt'])
        && d.email == request.auth.token.email
        && d.name is string && d.name.size() <= 100
        && d.grade is int && (d.grade == 0 || validGrade(d.grade))
        && d.lastSeenAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Khách dùng thử không đăng nhập (Firebase Anonymous Auth, src/engine/leaderboard.js registerGuest):
    // mỗi trình duyệt tự ghi bản của mình tối đa 1 lần/ngày; admin đọc tất cả (thống kê trang #admin),
    // khách chỉ đọc bản của mình. convertedAt: lúc khách đó đăng nhập Google (ghi một lần).
    function validGuest(d) {
      return d.keys().hasOnly(['nickname', 'avatar', 'grade', 'stars', 'device', 'days', 'createdAt', 'lastSeenAt', 'convertedAt'])
        && d.nickname is string && d.nickname.size() <= 20
        && d.avatar is string && d.avatar.size() <= 40
        && d.grade is int && (d.grade == 0 || validGrade(d.grade))
        && validStars(d.stars)
        && d.device is string && d.device.size() <= 120
        && (!('days' in d) || (d.days is list && d.days.size() <= 1000))
        && (!('convertedAt' in d) || d.convertedAt is timestamp);
    }

    match /guests/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isOwner(uid) && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && validGuest(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && !('convertedAt' in request.resource.data);
      allow update: if isOwner(uid) && validGuest(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.lastSeenAt == request.time
          || request.resource.data.lastSeenAt == resource.data.lastSeenAt)
        && (!('convertedAt' in resource.data) || request.resource.data.convertedAt == resource.data.convertedAt)
        && (!('convertedAt' in request.resource.data) || 'convertedAt' in resource.data
          || request.resource.data.convertedAt == request.time);
      allow delete: if isAdmin();
    }

    // Cấu hình app do admin bật / tắt (src/engine/leaderboard.js isGuestEnabled): ai cũng đọc được,
    // kể cả lúc chưa đăng nhập (màn đăng nhập cần biết có hiện nút "Dùng thử" không); chỉ admin ghi.
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin() && id == 'app'
        && request.resource.data.keys().hasOnly(['guestEnabled', 'updatedAt'])
        && request.resource.data.guestEnabled is bool
        && request.resource.data.updatedAt == request.time;
    }

    // Mỗi máy một khách (src/engine/leaderboard.js claimGuestDevice): `{mã máy băm}` → uid ẩn danh đầu tiên
    // dùng thử trên máy đó. Khách chỉ đọc từng mã (không liệt kê), chỉ ghi một lần với uid của chính mình;
    // không ai sửa được. Admin xem / xoá (xoá = máy đó được dùng thử lại).
    match /guestDevices/{key} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && key.matches('[0-9a-f]{32}')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // Đánh giá ứng dụng: mỗi tài khoản một đánh giá (gửi lại = sửa), ai đăng nhập cũng xem được.
    // `reply` là phản hồi của admin — bé không tạo/sửa được; admin chỉ sửa được `reply` hoặc xoá cả đánh giá.
    function validReview(d) {
      return d.keys().hasOnly(['rating', 'comment', 'name', 'avatar', 'grade', 'createdAt', 'updatedAt', 'reply'])
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.comment is string && d.comment.size() <= 1000
        && d.name is string && d.name.size() <= 40
        && d.avatar is string && d.avatar.size() <= 40
        && d.grade is int && (d.grade == 0 || validGrade(d.grade))
        && d.updatedAt == request.time;
    }

    function validReply(r) {
      return r is map && r.keys().hasOnly(['message', 'updatedAt'])
        && r.message is string && r.message.size() >= 1 && r.message.size() <= 1000
        && r.updatedAt == request.time;
    }

    match /reviews/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid) && validReview(request.resource.data)
        && request.resource.data.createdAt == request.time
        && !('reply' in request.resource.data);
      allow update: if (isOwner(uid) && validReview(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('reply', null) == resource.data.get('reply', null))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
          && (!('reply' in request.resource.data) || validReply(request.resource.data.reply)));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Máy không có giọng đọc tiếng Việt (src/engine/voiceReport.js): mỗi máy một bản ghi
    // `{uid}_{mã máy}`, bé chỉ đọc/ghi được bản của mình; admin đọc tất cả và xoá.
    function validVoiceIssue(d) {
      return d.keys().hasOnly(['uid', 'email', 'status', 'browser', 'os', 'device', 'model', 'ua',
                               'voices', 'langs', 'online', 'createdAt', 'lastSeenAt'])
        && d.uid == request.auth.uid
        && d.email is string && d.email.size() <= 200
        && d.status in ['online', 'none', 'local']
        && d.browser is string && d.browser.size() <= 60
        && d.os is string && d.os.size() <= 60
        && d.device is string && d.device.size() <= 40
        && d.model is string && d.model.size() <= 80
        && d.ua is string && d.ua.size() <= 400
        && d.voices is int && d.voices >= 0 && d.voices <= 9999
        && d.langs is string && d.langs.size() <= 400
        && d.online is bool
        && d.lastSeenAt == request.time;
    }

    match /voiceIssues/{id} {
      allow read: if isAdmin() || (request.auth != null && id.matches(request.auth.uid + '_[A-Za-z0-9]+'));
      allow delete: if isAdmin();
      allow create: if request.auth != null && id.matches(request.auth.uid + '_[A-Za-z0-9]+')
        && validVoiceIssue(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && id.matches(request.auth.uid + '_[A-Za-z0-9]+')
        && validVoiceIssue(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
